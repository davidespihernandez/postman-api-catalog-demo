# Local config for `npm run mqtt-bridge` (running the MQTT -> webhook bridge on your laptop).
# In production the bridge runs on the AWS VM as a systemd service reading runtime-vm/.env;
# this file is only needed if you want to run the bridge locally for testing.

# NOTIFICATION_WEBHOOK_URL=https://YOUR-NOTIFICATION-WEBHOOK.webhook.pstmn.io/
# MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
# MQTT_TOPIC=postman-api-catalog-demo/notifications
