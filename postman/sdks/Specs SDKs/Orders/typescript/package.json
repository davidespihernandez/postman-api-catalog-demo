{
  "name": "orders-sdk",
  "version": "1.0.0",
  "description": "Demo orders service for the Postman API Catalog walkthrough.  Optional query parameters on all endpoints except /openapi.json: - delay or wait: milliseconds to wait before responding (max 30000) - status or error: HTTP status code to return (e.g. 500); error=true also returns 500",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "browser": "./dist/index.js",
  "unpkg": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "tsc --noEmit",
    "build": "tsup-node src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "chmod +x ./scripts/prepublish.sh && ./scripts/prepublish.sh && npm run build",
    "test-example": "cd examples && tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "sdk",
    "api",
    "client"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "author": "",
  "devDependencies": {
    "typescript": "5.3.3",
    "@types/node": "^22.14.0",
    "tsup": "^6.7.0"
  },
  "dependencies": {
    "zod": "3.22.3"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  }
}
