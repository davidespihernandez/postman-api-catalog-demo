# Runtime-VM stack config. Copy to `.env` on the VM and fill in.
# cp .env.example .env && nano .env

# Public hostname (one host, path-routed to all three APIs). On AWS this is the
# Elastic IP as a nip.io name: <elastic-ip-with-dashes>.nip.io (stable — the EIP is static).
# The stack serves the APIs under one host:
#   https://<HOSTNAME>/orders   /payments   /users   /health
HOSTNAME=CHANGE-ME.nip.io

# Postman API key (same one used by the CI). Insights agent authenticates with this.
POSTMAN_API_KEY=PMAK-xxxxxxxxxxxxxxxxxxxxxxxx

# From the API Catalog "No endpoint data available" panel (--workspace-id / --system-env).
INSIGHTS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
INSIGHTS_SYSTEM_ENV=00000000-0000-0000-0000-000000000000

# Optional: Payments refund webhook. If set, the Payments worker receives it as
# env.REFUND_WEBHOOK_URL and POSTs a payment.refunded event there on /payments/refund.
REFUND_WEBHOOK_URL=

# Optional: MQTT -> Postman webhook bridge (async notifications demo).
# If set, the VM runs an always-on consumer that subscribes to the MQTT topic
# and forwards messages to this Postman webhook (so nothing runs on a laptop).
NOTIFICATION_WEBHOOK_URL=
# MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883          # default shown
# MQTT_TOPIC=postman-api-catalog-demo/notifications      # default shown

# Loopback ports for the three Node API servers (rarely need changing).
ORDERS_PORT=8787
PAYMENTS_PORT=8788
USERS_PORT=8789
