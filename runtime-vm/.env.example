# Runtime-VM stack config. Copy to `.env` on the VM and fill in.
# cp .env.example .env && nano .env

# Public hostname that resolves to this VM's public IP (see ORACLE-INSIGHTS.md Part 5).
# Use nip.io wildcard so each API gets its own subdomain, e.g. for IP 130.61.1.2 -> 130-61-1-2.nip.io
# The stack serves:  orders.<HOSTNAME>  payments.<HOSTNAME>  users.<HOSTNAME>
HOSTNAME=CHANGE-ME.nip.io

# Postman API key (same one used by the CI). Insights agent authenticates with this.
POSTMAN_API_KEY=PMAK-xxxxxxxxxxxxxxxxxxxxxxxx

# From the API Catalog "No endpoint data available" panel (each SE has their own).
INSIGHTS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
INSIGHTS_SYSTEM_ENV=00000000-0000-0000-0000-000000000000

# Loopback ports for the three wrangler dev backends (rarely need changing).
ORDERS_PORT=8787
PAYMENTS_PORT=8788
USERS_PORT=8789
