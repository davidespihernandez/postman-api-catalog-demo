# Config for control.sh (GCP side). Copy to gcp.env and edit.
#   cp gcp.env.example gcp.env
# (gcp.env is git-ignored — these identify YOUR instance; each SE has their own.)

GCP_PROJECT=postman-insights-xxxxx
GCP_ZONE=us-west1-a
GCP_INSTANCE=postman-insights-demo

# Local SSH private key that matches the key added to the VM.
SSH_KEY=~/.ssh/postman-insights

# Your DuckDNS hostname (used to print URLs / health-check in `status`).
DEMO_HOST=CHANGE-ME.duckdns.org
