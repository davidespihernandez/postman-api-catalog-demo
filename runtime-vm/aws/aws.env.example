# Config for control.sh (AWS side). Copy to aws.env and edit.
#   cp aws.env.example aws.env
# (aws.env is git-ignored.) Managed via SSM (no public SSH — enterprise NACL blocks 22).

AWS_REGION=eu-central-1
AWS_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
AWS_HOST=CHANGE-ME.nip.io          # <elastic-ip-with-dashes>.nip.io
